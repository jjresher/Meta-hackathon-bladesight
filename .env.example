# Copy to .env (never commit .env). Values are secrets: never print them.
META_API_KEY=
# optional; defaults to https://api.meta.ai (with or without a trailing /v1)
META_API_BASE_URL=
# optional model id overrides (defaults: muse-spark-1.3, sam-3.1; never a -contributor model)
# META_CHAT_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
# Caps are CUMULATIVE across runs and processes, summed per provider from .spend/spend_log.jsonl
META_SPEND_LIMIT_USD=0.50
BASETEN_API_KEY=
# optional; default https://inference.baseten.co/v1
# BASETEN_BASE_URL=
BASETEN_SPEND_LIMIT_USD=10.00
# replay (default for the public demo) or live
BLADESIGHT_MODE=replay
